# Environment variables used by CI / the reference backend. Never commit real values.
# --- Android build (non-secret, becomes BuildConfig) ---
NAVER_CLIENT_ID=
NAVER_REDIRECT_URI=https://your-worker.example.workers.dev/naver/callback
NAVER_TOKEN_EXCHANGE_URL=https://your-worker.example.workers.dev/naver/token
AI_PROXY_BASE_URL=https://your-worker.example.workers.dev
# --- Backend secrets (wrangler secret put …) ---
NAVER_CLIENT_SECRET=
ANTHROPIC_API_KEY=
APP_TOKENS=
# --- Release signing (GitHub Secrets) ---
RELEASE_KEYSTORE_BASE64=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
